# Géré par Ansible - {{ inventory_hostname }}
global_defs {
    router_id {{ inventory_hostname }}
    enable_script_security
    script_user root
}

vrrp_script chk_haproxy {
    script "/etc/keepalived/chk_haproxy.sh"
    interval 2
    fall 2
    rise 2
}

vrrp_instance VI_PG {
    state BACKUP
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_router_id }}
    priority {{ 150 - (node_id | int - 1) * 10 }}
    advert_int 1

    unicast_src_ip {{ ansible_host }}
    unicast_peer {
{% for h in groups['lb'] if h != inventory_hostname %}
        {{ hostvars[h].ansible_host }}
{% endfor %}
    }

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    virtual_ipaddress {
        {{ keepalived_vip }}/{{ keepalived_vip_prefix }} dev {{ keepalived_interface }}
    }

    track_script {
        chk_haproxy
    }
}
